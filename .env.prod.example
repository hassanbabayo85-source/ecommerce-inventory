# ============================================================
# Production environment — DO NOT COMMIT .env.prod
# Copy:  cp .env.prod.example .env.prod
# Then edit and generate strong secrets:
#   openssl rand -hex 32
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=ecommerce

# --- Application ---
ADMIN_API_KEY=CHANGE_ME_openssl_rand_hex_32
CORS_ALLOWED_ORIGINS=https://app.example.com
DB_MAX_CONNECTIONS=10
RUST_LOG=ecommerce_inventory=info,tower_http=warn

# --- Caddy / TLS ---
# DOMAIN must have a public DNS A record pointing at this host.
# Caddy fetches the TLS certificate automatically from Let's Encrypt.
DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
