# ============================================================
# Local development defaults — DO NOT use these in production.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
APP_PORT=8080

# --- Application ---
DATABASE_URL=postgres://ecommerce:ecommerce@postgres:5432/ecommerce
RUST_LOG=ecommerce_inventory=info,tower_http=info

# --- Security (REQUIRED) ---
# Admin API key: min 16 chars, random. Generate with:
#   openssl rand -hex 32
ADMIN_API_KEY=dev-admin-key-1234567890-abcd

# Comma-separated allowed CORS origins.
# Empty / "*" = permissive (dev only).
# Production example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
